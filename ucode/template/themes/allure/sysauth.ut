{# Allure LuCI 1.4 login. Authentic LuCI POST; no client-side credential handling. #}
{% include('header', { blank_page: true }) %}
<script>document.body.classList.add('allure-login');</script>
<main class="allure-auth" aria-label="Router sign in">
  <div class="allure-auth-scene" aria-hidden="true">
    <div class="allure-auth-backdrop"></div>
    <div class="allure-auth-aurora allure-auth-aurora-a"></div>
    <div class="allure-auth-aurora allure-auth-aurora-b"></div>
    <div class="allure-auth-aurora allure-auth-aurora-c"></div>
    <div class="allure-auth-ribbon"></div>
    <div class="allure-auth-dust"></div>
    <div class="allure-auth-starfield"></div>
    <div class="allure-auth-waterlight"></div>
    <div class="allure-auth-shimmer"></div>
    <div class="allure-auth-vignette"></div>
  </div>
  <section class="allure-auth-card" aria-labelledby="allure-auth-title">
    <div class="allure-auth-logo" aria-hidden="true">
      <svg viewBox="0 0 64 64" fill="none"><defs><linearGradient id="allure-gem" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#cb8dff"/><stop offset="1" stop-color="#637cff"/></linearGradient></defs><path d="M32 4 59 32 32 60 5 32 32 4Z" stroke="url(#allure-gem)" stroke-width="4"/><path d="M32 16 47 32 32 48 17 32 32 16Z" stroke="url(#allure-gem)" stroke-width="3.5"/></svg>
    </div>
    <h1 id="allure-auth-title">Allure</h1>
    <p class="allure-auth-kicker" data-auth-i18n="product">Router · OpenWrt</p>
    {% if (auth_message): %}
      <div class="allure-auth-notice" role="alert">{{ auth_message }}</div>
    {% elif (fuser): %}
      <div class="allure-auth-notice" role="alert">{{ _('Invalid username and/or password! Please try again.') }}</div>
    {% endif %}
    <form method="post" class="allure-auth-form" autocomplete="on" action="{{ dispatcher.build_url() }}">
      <label class="allure-auth-label" for="luci_username" data-auth-i18n="username">Username</label>
      <div class="allure-auth-field">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg>
        <input name="luci_username" id="luci_username" type="text" autocomplete="username" spellcheck="false" placeholder="Username" data-auth-i18n-placeholder="username" value="{{ entityencode(duser, true) }}">
      </div>
      <label class="allure-auth-label" for="luci_password" data-auth-i18n="password">Password</label>
      <div class="allure-auth-field">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
        <input name="luci_password" id="luci_password" type="password" autocomplete="current-password" placeholder="Password" data-auth-i18n-placeholder="password" autofocus>
        <button type="button" id="allure-password-toggle" class="allure-auth-password-toggle" aria-label="Show password" aria-pressed="false" title="Show password">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/><path d="M4 4 20 20"/></svg>
        </button>
      </div>
      {% if (auth_fields): %}
        {% for (let field in auth_fields): %}
          <label class="allure-auth-extra-label" for="{{ entityencode(field.name, true) }}">{{ _(field.label ?? field.name) }}</label>
          <div class="allure-auth-field allure-auth-extra">
            <input name="{{ entityencode(field.name, true) }}" id="{{ entityencode(field.name, true) }}" type="{{ entityencode(field.type ?? 'text', true) }}"
              {% if (field.placeholder): %}placeholder="{{ entityencode(field.placeholder, true) }}"{% endif %}
              {% if (field.inputmode): %}inputmode="{{ entityencode(field.inputmode, true) }}"{% endif %}
              {% if (field.pattern): %}pattern="{{ entityencode(field.pattern, true) }}"{% endif %}
              {% if (field.maxlength): %}maxlength="{{ field.maxlength }}"{% endif %}
              {% if (field.autocomplete): %}autocomplete="{{ entityencode(field.autocomplete, true) }}"{% endif %}
              {% if (field.required): %}required{% endif %}>
          </div>
        {% endfor %}
      {% endif %}
      {% if (auth_html): %}<div class="allure-auth-challenge">{{ auth_html }}</div>{% endif %}
      {% if (auth_assets): %}
        {% for (let asset in auth_assets): %}
          {% if (asset.type == 'script'): %}<script src="{{ asset.src }}"></script>{% endif %}
        {% endfor %}
      {% endif %}
      <button type="submit" class="allure-auth-submit"><span data-auth-i18n="signIn">Sign in</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h16m-7-7 7 7-7 7"/></svg></button>
    </form>
    <div class="allure-auth-separator"><span data-auth-i18n="or">or</span></div>
    <div class="allure-auth-theme" role="group" aria-label="Appearance">
      <button type="button" data-allure-theme="light" aria-label="Light mode" title="Light mode"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><span data-auth-i18n="light">Light</span></button>
      <button type="button" data-allure-theme="dark" aria-label="Dark mode" title="Dark mode"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M20.7 15.8a8.8 8.8 0 0 1-12.5-12A9 9 0 1 0 20.7 15.8z"/></svg><span data-auth-i18n="dark">Dark</span></button>
      <button type="button" data-allure-theme="auto" aria-label="System appearance" title="Follow system"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 22h8m-4-4v4"/></svg><span data-auth-i18n="auto">System</span></button>
    </div>
  </section>
</main>
<script src="{{ media }}/allure-auth.js?v=1.6.0" defer></script>
{% include('footer', { blank_page: true }) %}
