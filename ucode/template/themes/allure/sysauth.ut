{# Allure login theme for LuCI ucode (OpenWrt 25.12+).
   Uses the stock LuCI POST fields: authentication remains on the router.
   The form is functional without JavaScript. #}
{% include('header', { blank_page: true }) %}
<script>document.body.classList.add('allure-login');</script>
<main class="allure-auth" aria-label="Router sign in">
  <div class="allure-auth-scene" aria-hidden="true">
    <div class="allure-auth-stars"></div>
    <div class="allure-auth-glow allure-auth-glow-a"></div>
    <div class="allure-auth-glow allure-auth-glow-b"></div>
    <div class="allure-auth-glow allure-auth-glow-c"></div>
    <div class="allure-auth-horizon"></div>
  </div>
  <section class="allure-auth-card" aria-labelledby="allure-auth-title">
    <div class="allure-auth-logo" aria-hidden="true">
      <svg viewBox="0 0 64 64" fill="none"><path d="M32 5 59 32 32 59 5 32 32 5Z" stroke="currentColor" stroke-width="3"/><path d="M32 17 47 32 32 47 17 32 32 17Z" stroke="currentColor" stroke-width="3"/></svg>
    </div>
    <h1 id="allure-auth-title">Allure</h1>
    <p class="allure-auth-kicker" data-auth-i18n="product">OpenWrt · Router Control</p>
    <div class="allure-auth-divider"></div>
    <h2 data-auth-i18n="welcome">Welcome back</h2>
    <p class="allure-auth-description" data-auth-i18n="description">Sign in to manage your router</p>
    {% if (auth_message): %}
      <div class="allure-auth-notice" role="alert">{{ auth_message }}</div>
    {% elif (fuser): %}
      <div class="allure-auth-notice" role="alert">{{ _('Invalid username and/or password! Please try again.') }}</div>
    {% endif %}
    <form method="post" class="allure-auth-form" autocomplete="on">
      <label for="luci_username" data-auth-i18n="username">Username</label>
      <div class="allure-auth-field">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg>
        <input name="luci_username" id="luci_username" type="text" autocomplete="username" spellcheck="false" value="{{ entityencode(duser, true) }}">
      </div>
      <label for="luci_password" data-auth-i18n="password">Password</label>
      <div class="allure-auth-field">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
        <input name="luci_password" id="luci_password" type="password" autocomplete="current-password" autofocus>
        <button type="button" id="allure-password-toggle" class="allure-auth-password-toggle" aria-label="Show password" data-auth-i18n-aria="showPassword" aria-pressed="false" title="Show password">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
      </div>
      {% if (auth_fields): %}
        {% for (let field in auth_fields): %}
          <label for="{{ entityencode(field.name, true) }}">{{ _(field.label ?? field.name) }}</label>
          <div class="allure-auth-field allure-auth-extra">
            <input name="{{ entityencode(field.name, true) }}" id="{{ entityencode(field.name, true) }}" type="{{ entityencode(field.type ?? 'text', true) }}"
              {% if (field.placeholder): %}placeholder="{{ entityencode(field.placeholder, true) }}"{% endif %}
              {% if (field.inputmode): %}inputmode="{{ entityencode(field.inputmode, true) }}"{% endif %}
              {% if (field.pattern): %}pattern="{{ entityencode(field.pattern, true) }}"{% endif %}
              {% if (field.maxlength): %}maxlength="{{ field.maxlength }}"{% endif %}
              {% if (field.autocomplete): %}autocomplete="{{ entityencode(field.autocomplete, true) }}"{% endif %}
              {% if (field.required): %}required{% endif %}>
          </div>
        {% endfor %}
      {% endif %}
      {% if (auth_html): %}<div class="allure-auth-challenge">{{ auth_html }}</div>{% endif %}
      {% if (auth_assets): %}
        {% for (let asset in auth_assets): %}
          {% if (asset.type == 'script'): %}<script src="{{ asset.src }}"></script>{% endif %}
        {% endfor %}
      {% endif %}
      <button type="submit" class="allure-auth-submit"><span data-auth-i18n="signIn">Sign in</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h16m-7-7 7 7-7 7"/></svg></button>
    </form>
    <div class="allure-auth-bottom">
      <div class="allure-auth-status"><span></span><span>OpenWrt</span><span class="allure-auth-status-separator">·</span><span data-auth-i18n="secure">Router management</span></div>
      <div class="allure-auth-theme" role="group" aria-label="Appearance">
        <button type="button" data-allure-theme="light" aria-label="Light mode" title="Light mode"><span>☼</span><span data-auth-i18n="light">Light</span></button>
        <button type="button" data-allure-theme="dark" aria-label="Dark mode" title="Dark mode"><span>☾</span><span data-auth-i18n="dark">Dark</span></button>
        <button type="button" data-allure-theme="auto" aria-label="System appearance" title="Follow system"><span>◐</span><span data-auth-i18n="auto">Auto</span></button>
      </div>
    </div>
  </section>
  <div class="allure-auth-corner"><span data-auth-i18n="madeFor">Made for OpenWrt</span><span class="allure-auth-dot">·</span>Allure UI</div>
</main>
<script src="{{ media }}/allure-auth.js?v=1.3.0" defer></script>
{% include('footer', { blank_page: true }) %}
